{
  "spec_version": 1,
  "diagram_id": "db_structure_v1",
  "title": "Surf SQLite database — 8 tables and how they connect",
  "purpose": "Show every table the app stores data in, the columns each table holds, and which columns reference which other table (foreign keys). The teacher should be able to ask 'where does X live?' and find the answer here.",
  "audience": "non-engineer teammates and the grading teacher",
  "linked_sidecars": [
    "app/db/schema/schema.md",
    "app/db/connection.md",
    "app/db/queries_users/queries_users.md",
    "app/db/queries_classes/queries_classes.md",
    "app/db/queries_lectures/queries_lectures.md",
    "app/db/queries_learning_objectives/queries_learning_objectives.md",
    "app/db/queries_pages/queries_pages.md",
    "app/db/queries_questions/queries_questions.md"
  ],
  "groups": [
    { "id": "tbl_users", "label": "users — the single account that owns everything (D-3.1: app is single-user)" },
    { "id": "tbl_classes", "label": "classes — one row per HSG course; carries the cleaned factsheet as JSON" },
    { "id": "tbl_lectures", "label": "lectures — one row per uploaded lecture PDF; status tracks ingestion progress" },
    { "id": "tbl_learning_objectives", "label": "learning_objectives — one row per LO Claude found in the lecture, with the page range it covers" },
    { "id": "tbl_slide_pages", "label": "slide_pages — one row per slide; status says whether the slide was kept, ignored, or failed" },
    { "id": "tbl_questions", "label": "questions — one row per MCQ Claude generated for a slide" },
    { "id": "tbl_attempts", "label": "attempts — one row per mock the user takes (Phase 2 will populate; included now per DB-01)" },
    { "id": "tbl_attempt_answers", "label": "attempt_answers — one row per question shown in an attempt (Phase 2 will populate)" }
  ],
  "nodes": [
    { "id": "users.id", "kind": "db_column", "label": "id (PK)", "group": "tbl_users", "description": "Primary key" },
    { "id": "users.username", "kind": "db_column", "label": "username", "group": "tbl_users", "description": "Unique" },
    { "id": "users.anthropic_api_key", "kind": "db_column", "label": "anthropic_api_key", "group": "tbl_users", "description": "Plaintext on disk — local-only app" },
    { "id": "users.created_at", "kind": "db_column", "label": "created_at", "group": "tbl_users" },

    { "id": "classes.id", "kind": "db_column", "label": "id (PK)", "group": "tbl_classes" },
    { "id": "classes.user_id", "kind": "db_column", "label": "user_id (FK)", "group": "tbl_classes", "description": "ON DELETE CASCADE" },
    { "id": "classes.name", "kind": "db_column", "label": "name", "group": "tbl_classes" },
    { "id": "classes.factsheet_json", "kind": "db_column", "label": "factsheet_json", "group": "tbl_classes", "description": "Cleaned factsheet stored as JSON in one column — no separate factsheet table (D-1.2)" },
    { "id": "classes.pass_threshold_pct", "kind": "db_column", "label": "pass_threshold_pct", "group": "tbl_classes", "description": "Default 50" },
    { "id": "classes.created_at", "kind": "db_column", "label": "created_at", "group": "tbl_classes" },

    { "id": "lectures.id", "kind": "db_column", "label": "id (PK)", "group": "tbl_lectures" },
    { "id": "lectures.class_id", "kind": "db_column", "label": "class_id (FK)", "group": "tbl_lectures", "description": "ON DELETE CASCADE" },
    { "id": "lectures.title", "kind": "db_column", "label": "title", "group": "tbl_lectures" },
    { "id": "lectures.source_pdf_path", "kind": "db_column", "label": "source_pdf_path", "group": "tbl_lectures" },
    { "id": "lectures.total_pages", "kind": "db_column", "label": "total_pages", "group": "tbl_lectures" },
    { "id": "lectures.status", "kind": "db_column", "label": "status", "group": "tbl_lectures", "description": "'pending' or 'ready' — flips to 'ready' after MCQs are generated" },
    { "id": "lectures.created_at", "kind": "db_column", "label": "created_at", "group": "tbl_lectures" },

    { "id": "learning_objectives.id", "kind": "db_column", "label": "id (PK)", "group": "tbl_learning_objectives" },
    { "id": "learning_objectives.lecture_id", "kind": "db_column", "label": "lecture_id (FK)", "group": "tbl_learning_objectives", "description": "ON DELETE CASCADE" },
    { "id": "learning_objectives.title", "kind": "db_column", "label": "title", "group": "tbl_learning_objectives", "description": "The LO sentence Claude extracted" },
    { "id": "learning_objectives.page_start", "kind": "db_column", "label": "page_start", "group": "tbl_learning_objectives" },
    { "id": "learning_objectives.page_end", "kind": "db_column", "label": "page_end", "group": "tbl_learning_objectives" },
    { "id": "learning_objectives.created_at", "kind": "db_column", "label": "created_at", "group": "tbl_learning_objectives" },

    { "id": "slide_pages.id", "kind": "db_column", "label": "id (PK)", "group": "tbl_slide_pages" },
    { "id": "slide_pages.lecture_id", "kind": "db_column", "label": "lecture_id (FK)", "group": "tbl_slide_pages", "description": "ON DELETE CASCADE" },
    { "id": "slide_pages.page_number", "kind": "db_column", "label": "page_number", "group": "tbl_slide_pages", "description": "UNIQUE per (lecture_id, page_number)" },
    { "id": "slide_pages.raw_md", "kind": "db_column", "label": "raw_md", "group": "tbl_slide_pages", "description": "The slide's markdown text" },
    { "id": "slide_pages.status", "kind": "db_column", "label": "status", "group": "tbl_slide_pages", "description": "'kept' (used for MCQs), 'ignored' (skipped — divider/title slide), 'pending' (Claude failed twice)" },
    { "id": "slide_pages.learning_objective_id", "kind": "db_column", "label": "learning_objective_id (FK)", "group": "tbl_slide_pages", "description": "ON DELETE SET NULL — which LO this slide teaches" },
    { "id": "slide_pages.created_at", "kind": "db_column", "label": "created_at", "group": "tbl_slide_pages" },

    { "id": "questions.id", "kind": "db_column", "label": "id (PK)", "group": "tbl_questions" },
    { "id": "questions.slide_page_id", "kind": "db_column", "label": "slide_page_id (FK)", "group": "tbl_questions", "description": "ON DELETE CASCADE — every MCQ traces back to one slide" },
    { "id": "questions.question_text", "kind": "db_column", "label": "question_text", "group": "tbl_questions" },
    { "id": "questions.options_json", "kind": "db_column", "label": "options_json", "group": "tbl_questions", "description": "Always 4 options, JSON-encoded list" },
    { "id": "questions.correct_indices", "kind": "db_column", "label": "correct_indices", "group": "tbl_questions", "description": "Always a list — supports multi-correct MCQs (D-2.5)" },
    { "id": "questions.rationales_per_option_json", "kind": "db_column", "label": "rationales_per_option_json", "group": "tbl_questions", "description": "One rationale per option (4)" },
    { "id": "questions.source_page", "kind": "db_column", "label": "source_page", "group": "tbl_questions" },
    { "id": "questions.language", "kind": "db_column", "label": "language", "group": "tbl_questions" },
    { "id": "questions.difficulty_word_count", "kind": "db_column", "label": "difficulty_word_count", "group": "tbl_questions", "description": "1 of 6 difficulty features (locked, computed in Phase 1)" },
    { "id": "questions.difficulty_readability", "kind": "db_column", "label": "difficulty_readability", "group": "tbl_questions", "description": "Locked feature — nullable until Phase 4" },
    { "id": "questions.difficulty_distractor_similarity", "kind": "db_column", "label": "difficulty_distractor_similarity", "group": "tbl_questions", "description": "Locked feature — nullable until Phase 4" },
    { "id": "questions.difficulty_conceptual_density", "kind": "db_column", "label": "difficulty_conceptual_density", "group": "tbl_questions", "description": "Pending feature — Phase 4" },
    { "id": "questions.difficulty_distractor_derivation", "kind": "db_column", "label": "difficulty_distractor_derivation", "group": "tbl_questions", "description": "Pending feature — Phase 4" },
    { "id": "questions.difficulty_reasoning_steps", "kind": "db_column", "label": "difficulty_reasoning_steps", "group": "tbl_questions", "description": "Pending feature — Phase 4" },
    { "id": "questions.difficulty_score", "kind": "db_column", "label": "difficulty_score", "group": "tbl_questions", "description": "Final score — filled by trained ML model in Phase 4" },
    { "id": "questions.created_at", "kind": "db_column", "label": "created_at", "group": "tbl_questions" },

    { "id": "attempts.id", "kind": "db_column", "label": "id (PK)", "group": "tbl_attempts" },
    { "id": "attempts.class_id", "kind": "db_column", "label": "class_id (FK)", "group": "tbl_attempts", "description": "ON DELETE CASCADE" },
    { "id": "attempts.mock_kind", "kind": "db_column", "label": "mock_kind", "group": "tbl_attempts", "description": "Standard / study-next / etc." },
    { "id": "attempts.started_at", "kind": "db_column", "label": "started_at", "group": "tbl_attempts" },
    { "id": "attempts.finished_at", "kind": "db_column", "label": "finished_at", "group": "tbl_attempts" },
    { "id": "attempts.correct_count", "kind": "db_column", "label": "correct_count", "group": "tbl_attempts" },
    { "id": "attempts.total_count", "kind": "db_column", "label": "total_count", "group": "tbl_attempts" },

    { "id": "attempt_answers.id", "kind": "db_column", "label": "id (PK)", "group": "tbl_attempt_answers" },
    { "id": "attempt_answers.attempt_id", "kind": "db_column", "label": "attempt_id (FK)", "group": "tbl_attempt_answers", "description": "ON DELETE CASCADE" },
    { "id": "attempt_answers.question_id", "kind": "db_column", "label": "question_id (FK)", "group": "tbl_attempt_answers", "description": "ON DELETE CASCADE" },
    { "id": "attempt_answers.selected_indices", "kind": "db_column", "label": "selected_indices", "group": "tbl_attempt_answers" },
    { "id": "attempt_answers.is_correct", "kind": "db_column", "label": "is_correct", "group": "tbl_attempt_answers" },
    { "id": "attempt_answers.answered_at", "kind": "db_column", "label": "answered_at", "group": "tbl_attempt_answers" }
  ],
  "edges": [
    { "from": "classes.user_id", "to": "users.id", "kind": "foreign_key" },
    { "from": "lectures.class_id", "to": "classes.id", "kind": "foreign_key" },
    { "from": "learning_objectives.lecture_id", "to": "lectures.id", "kind": "foreign_key" },
    { "from": "slide_pages.lecture_id", "to": "lectures.id", "kind": "foreign_key" },
    { "from": "slide_pages.learning_objective_id", "to": "learning_objectives.id", "kind": "foreign_key", "description": "Each kept slide is attached to exactly one LO" },
    { "from": "questions.slide_page_id", "to": "slide_pages.id", "kind": "foreign_key" },
    { "from": "attempts.class_id", "to": "classes.id", "kind": "foreign_key" },
    { "from": "attempt_answers.attempt_id", "to": "attempts.id", "kind": "foreign_key" },
    { "from": "attempt_answers.question_id", "to": "questions.id", "kind": "foreign_key" }
  ],
  "verification": [
    "All 8 tables are present as groups: users, classes, lectures, learning_objectives, slide_pages, questions, attempts, attempt_answers",
    "All 9 foreign keys are present as edges (kind=foreign_key)",
    "The slide_pages → learning_objectives FK is shown (this was missed in v0 of the diagram)",
    "Every column listed in app/db/schema/schema.sql appears as a node — including the 6 difficulty_* columns + difficulty_score",
    "No labeled connectors — relationship meaning is conveyed by sticky notes only",
    "Questions and attempts are NOT directly linked — they are joined via attempt_answers (many-to-many)"
  ]
}
