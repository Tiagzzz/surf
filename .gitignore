AGENTS.md
CLAUDE.md
SAFE_CLEANUP_AND_CONTINUATION_PLAN.md

# Keep internal documentation local while allowing the team learning docs to be
# tracked for the handoff repo.
docs/*
!docs/team/
!docs/team/**
docs/handoffs/
docs/implementation_plan/
docs/registers/
docs/archive/

# Local-only generated/support packages for final handoff preparation.
teacher_package/
handoff_artifacts/

# Local-only development artifacts excluded from the teacher/public handoff.
# Tests and Streamlit preview sandboxes stay local-only except the minimal
# smoke harness that lets the GitHub handoff clone run `pytest -q`.
tests/*
!tests/test_smoke.py
previews/
PHASE-4-EXAMPLES/

# Local agent/worktree artifacts and scratchpads.
.claude/
.tmp/
Structure/

# Canvas/course downloads are local reference material, not repo source
canvas_downloads/

# Local GSD planning state; phase scratchwork stays local but the
# lessons/ subfolder (handoff docs, pattern libraries) is tracked so
# every machine can read what we learned from prior phases.
/.planning/*
!/.planning/lessons/

